{
  "name": "ui-mob-components",
  "version": "0.1.0",
  "description": "Reusable cross-platform React Native UI components",
  "author": "Tatiana Riestra",
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "bob build && npm run copy-tokens",
    "copy-tokens": "node scripts/copy-tokens.js",
    "clean": "bob clean",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      "commonjs",
      "typescript"
    ]
  },
  "peerDependencies": {
    "nativewind": "^4.2.7",
    "react": ">=18.2.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@storybook/react-native-web-vite": "^10.6.1",
    "@types/react": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-web": "^0.21.3",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}

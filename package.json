{
  "name": "ui-mob-components",
  "version": "0.1.0",
  "description": "Reusable cross-platform React Native UI components",
  "author": "Tatiana Riestra",
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "files": [
    "lib",
    "src",
    "utils",
    "tailwind.preset.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build && npm run copy-tokens",
    "copy-tokens": "node scripts/copy-tokens.js",
    "clean": "bob clean",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      "commonjs",
      "typescript"
    ]
  },
  "peerDependencies": {
    "nativewind": "^4.2.7",
    "react": ">=18.2.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-native-web-vite": "^10.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "chromatic": "^18.12.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "nativewind": "4.2.7",
    "playwright": "^1.64.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-web": "^0.21.3",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx}": "eslint --fix"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
